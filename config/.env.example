# config/.env.example — Template for secrets referenced by channels.yaml.
#
# Copy this file to config/.env and fill in real values:
#     cp config/.env.example config/.env
#
# The real config/.env is gitignored and must NEVER be committed.
# Only set the keys for channels you actually enable in channels.yaml.

# Values are EMPTY by design: a key left blank reads as "secret not set" so delivery
# reports a clear MISSING instead of trying a fake placeholder credential and failing.

# --- Email (only when delivery.email.provider: smtp) ---
# Password for the SMTP user in channels.yaml (delivery.email.smtp.password_env).
# For Gmail SMTP, use an app password, not your account password.
SMTP_PASSWORD=

# --- Telegram (only when delivery.telegram.transport: bot-api) ---
# Bot token from @BotFather (delivery.telegram.token_env).
TELEGRAM_BOT_TOKEN=

# --- Rocket.Chat ---
# Incoming webhook URL (delivery.rocketchat.webhook_url_env). No OAuth needed.
ROCKETCHAT_WEBHOOK_URL=

# --- Search (OPTIONAL; only when search.provider is tavily/perplexity in search.yaml) ---
# The default is Claude's built-in WebSearch in-agent, which needs no key.
# Set ONE of these to enable a headless / fact-check-corroboration search provider.
TAVILY_API_KEY=
# PERPLEXITY_API_KEY is shared across two slots, both OPT-IN:
#   1) search.yaml provider: perplexity  -> raw /search results for corroboration (§16)
#   2) research.yaml cross_check          -> Sonar /chat second opinion in research-build
#      Phase 6.5 (§15a). Setting this key auto-activates the cross-check unless
#      research.yaml sets cross_check.provider: none.
PERPLEXITY_API_KEY=

# --- Agent-runtime auth (OPTIONAL; only for the headless-AGENTIC scheduling path) ---
# These are NOT referenced by channels.yaml — they authenticate the CLI that runs the
# agentic weekly pipeline unattended from OS cron (docs/scheduling.md "C. Codex", or a
# headless `claude` run): the path that needs an LLM for the collect/synthesis steps.
# Leave BOTH blank if you schedule via Claude Code `/schedule` (cloud auth) or only run
# the deterministic headless scripts (build_digest.py + deliver.py + collect.py use NO
# LLM and need no key). Codex can also auth via a ChatGPT login instead of a key; an API
# key is the portable choice for cron — no interactive session to keep alive.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
